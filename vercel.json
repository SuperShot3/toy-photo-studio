{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "rewrites": [{ "source": "/prompt-builder", "destination": "/index.html" }],
  "functions": {
    "api/generate-photo.ts": {
      "maxDuration": 60,
      "memory": 1024
    },
    "api/improve-description.ts": {
      "maxDuration": 60,
      "memory": 1024
    }
  }
}
