{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "functions": {
    "api/generate-photo.ts": {
      "maxDuration": 60,
      "memory": 1024,
      "includeFiles": "{server/**,src/types.ts}"
    },
    "api/improve-description.ts": {
      "maxDuration": 60,
      "memory": 1024,
      "includeFiles": "{server/**,src/types.ts}"
    },
    "api/health.ts": {
      "includeFiles": "{server/**,src/types.ts}"
    }
  }
}
